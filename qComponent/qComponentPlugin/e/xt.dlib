# DLIB Files

class Main:
    name = "xt"
    dos = True
    requires = []

class DLIB:
    def xt_main(a, b):
        fta = a + b
        ftb = a - b
        ftc = a * b
        ftd = a / b
        for ft in [fta, ftb, ftc, ftd]:
            print(ft)

    def xc(a, b):
        qna = a ** b
        qnb = a % b
        qnc = a // b
        for qn in [qna, qnb, qnc]:
            print(qn)